{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-maahaan",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ab64eea3-d4e9-4994-8b67-f12bc360491e","database_name": "nova-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f781a498aa0b4ece9523dab0c3e26225" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
